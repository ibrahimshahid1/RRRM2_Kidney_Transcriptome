% uomtheme.sty - Custom tikzposter theme for large posters
% Adapted for use without the University of Melbourne package
% The palette and styles defined here provide a consistent look
% across blocks, titles and backgrounds.  Colours are defined using
% hex values to avoid reliance on external packages.  Users can tweak
% the colours below to suit their institutional branding.

\ProvidesPackage{uomtheme}[2026/03/25 Custom poster theme]

% Define colour palette
\definecolor{UoMBlue}{HTML}{003366}
\definecolor{UoMNavy}{HTML}{002147}
\definecolor{UoMLightBlue}{HTML}{0066CC}
\definecolor{UoMGray}{HTML}{F2F2F2}
\definecolor{UoMDarkGray}{HTML}{333333}
\definecolor{UoMWhite}{HTML}{FFFFFF}

% Pipeline Diagram Colours
\definecolor{SteelBlue}{HTML}{4682B4}
\definecolor{CoralAccent}{HTML}{FF7F50}
\definecolor{LavAccent}{HTML}{E6E6FA}
\definecolor{GreenAccent}{HTML}{32CD32}

% Colour style
\definecolorstyle{UoMStyle}{%
    \definecolor{colorOne}{named}{UoMNavy}
    \definecolor{colorTwo}{named}{UoMLightBlue}
    \definecolor{colorThree}{named}{UoMGray}
}{%
    % Background colours
    \colorlet{backgroundcolor}{white}
    \colorlet{framecolor}{colorOne}
    % Title colours
    \colorlet{titlefgcolor}{white}
    \colorlet{titlebgcolor}{colorOne}
    % Block colours
    \colorlet{blocktitlebgcolor}{colorOne}
    \colorlet{blocktitlefgcolor}{white}
    \colorlet{blockbodybgcolor}{white}
    \colorlet{blockbodyfgcolor}{UoMDarkGray}
    % Innerblock colours
    \colorlet{innerblocktitlebgcolor}{colorTwo}
    \colorlet{innerblocktitlefgcolor}{white}
    \colorlet{innerblockbodybgcolor}{UoMGray}
    \colorlet{innerblockbodyfgcolor}{UoMDarkGray}
    % Note colours
    \colorlet{notefgcolor}{white}
    \colorlet{notebgcolor}{colorTwo}
    \colorlet{notefrcolor}{colorTwo}
}

% Title style
\definetitlestyle{UoMTitle}{%
    width=\textwidth, linewidth=0pt,
    titletotopverticalspace=0mm, titletoblockverticalspace=15mm,
    innersep=12mm
}{%
    \begin{scope}[line width=0pt]
        \draw[fill=titlebgcolor, rounded corners=10pt]
            (\titleposleft,\titleposbottom)
            rectangle
            (\titleposright,\titlepostop);
    \end{scope}
}

% Block style
\defineblockstyle{UoMBlock}{%
    titlewidthscale=1, bodywidthscale=1,
    titleleft, titleoffsetx=0pt, titleoffsety=0pt,
    bodyoffsetx=0pt, bodyoffsety=0pt,
    bodyverticalshift=0pt, roundedcorners=5,
    linewidth=0.5pt, titleinnersep=8mm, bodyinnersep=8mm
}{%
    \draw[fill=blockbodybgcolor, rounded corners=\blockroundedcorners]
        (blockbody.south west) rectangle (blockbody.north east);
    \ifBlockHasTitle
        \draw[fill=blocktitlebgcolor, rounded corners=\blockroundedcorners]
            (blocktitle.south west) rectangle (blocktitle.north east);
    \fi
}

% Background style
\definebackgroundstyle{UoMBackground}{%
    \draw[line width=0pt, bottom color=white, top color=white]
        (bottomleft) rectangle (topright);
    \draw[line width=3pt, color=UoMNavy]
        ([shift={(6mm,6mm)}]bottomleft) rectangle ([shift={(-6mm,-6mm)}]topright);
}

% Layout theme
\definelayouttheme{UoMTheme}{%
    \usecolorstyle{UoMStyle}
    \usetitlestyle{UoMTitle}
    \useblockstyle{UoMBlock}
    \usebackgroundstyle{UoMBackground}
    \usenotestyle{Default}
}