# ===============================================
# RRRM-2 Kidney Transcriptome .gitignore
# ===============================================

# -----------------------------------------------
# Large Data Directories (Generated Results)
# -----------------------------------------------
# Processed data (embeddings, networks, residuals)
data/processed/
data/external/
data/networks/

# Raw data except README
data/raw/*
!data/raw/README.md

# Exports snapshots (large intermediate outputs)
exports/

# -----------------------------------------------
# Large File Formats (regardless of location)
# -----------------------------------------------
# Scientific data formats
*.h5ad
*.h5
*.hdf5
*.npy
*.npz
*.mtx
*.rds
*.parquet
*.pkl
*.pickle
*.emb

# Large CSVs (generated results over 10MB)
# Note: keeping smaller tables and metadata CSVs

# -----------------------------------------------
# Results - Exclude embeddings/models, keep figures/tables
# -----------------------------------------------
results/embeddings/
results/models/

# Keep results/figures/ and results/tables/ (small visualization outputs)
# Do NOT add results/figures/ or results/tables/ here

# -----------------------------------------------
# KEEP: plots/ directory (paper figures ~12MB)
# -----------------------------------------------
# Do NOT exclude plots/ - these are important outputs

# -----------------------------------------------
# Python Environment
# -----------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# -----------------------------------------------
# Jupyter Notebook
# -----------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# -----------------------------------------------
# IDEs and Editors
# -----------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# -----------------------------------------------
# Operating System
# -----------------------------------------------
.DS_Store
Thumbs.db

# -----------------------------------------------
# Logs and Temporary Files
# -----------------------------------------------
*.log
logs/
*.tmp
temp/
tmp/

# Debug logs in root (from deconvolution runs)
debug_*.txt
deconv_log*.txt
