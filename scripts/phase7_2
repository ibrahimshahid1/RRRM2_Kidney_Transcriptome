import os
import pandas as pd
import mygene

# ==========================================
# CONFIG
# ==========================================
BASE_DIR = "data"
TARGET_DIRS = [
    os.path.join(BASE_DIR, "results/phase5_silent_shifters_strict"),
    os.path.join(BASE_DIR, "results/phase7_grounding")
]

def map_ids_in_file(file_path):
    print(f"Processing {os.path.basename(file_path)}...")
    
    try:
        df = pd.read_csv(file_path, sep='\t')
    except:
        try:
            df = pd.read_csv(file_path) # Try comma if tab fails
        except:
            print(f"  -> Could not read file. Skipping.")
            return

    # Identify ID column (index or named column)
    id_col = None
    if 'gene' in df.columns:
        id_col = 'gene'
        ids = df['gene'].tolist()
    elif df.index.name == 'gene' or (isinstance(df.index[0], str) and df.index[0].startswith('ENSMUSG')):
        id_col = 'index'
        ids = df.index.tolist()
    else:
        # Fallback: Check first column
        first_val = str(df.iloc[0, 0])
        if first_val.startswith('ENSMUSG'):
            id_col = df.columns[0]
            ids = df.iloc[:, 0].tolist()
        else:
            print("  -> No Ensembl IDs found. Skipping.")
            return

    # Query MyGene
    print(f"  -> Querying MyGene.info for {len(ids)} genes...")
    mg = mygene.MyGeneInfo()
    
    # scope='ensembl.gene', fields='symbol', species='mouse'
    res = mg.querymany(ids, scopes='ensembl.gene', fields='symbol', species='mouse', verbose=False)
    
    # Create Mapping Dictionary
    # Handle cases where query returns nothing or multiple hits
    id_to_symbol = {}
    for item in res:
        query = item['query']
        symbol = item.get('symbol', query) # Fallback to ID if no symbol found
        id_to_symbol[query] = symbol

    # Apply Mapping
    if id_col == 'index':
        df['Symbol'] = df.index.map(id_to_symbol)
    else:
        df['Symbol'] = df[id_col].map(id_to_symbol)

    # Reorder columns to put Symbol next to ID
    cols = list(df.columns)
    cols.insert(1, cols.pop(cols.index('Symbol')))
    df = df[cols]

    # Save
    df.to_csv(file_path, sep='\t', index=(id_col=='index'))
    print(f"  -> Saved with symbols: {file_path}")

def main():
    for d in TARGET_DIRS:
        if not os.path.exists(d):
            continue
            
        for root, dirs, files in os.walk(d):
            for f in files:
                if f.endswith('.tsv') or f.endswith('.csv'):
                    map_ids_in_file(os.path.join(root, f))

if __name__ == "__main__":
    main()